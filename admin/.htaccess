<LimitExcept GET POST>
    Deny from all
</LimitExcept>


<FilesMatch "^\.">
    Require all denied
</FilesMatch>


<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>


<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (alert|prompt|confirm|eval|setInterval|setTimeout|document\.cookie) [NC,OR]
    RewriteCond %{QUERY_STRING} (onerror|onload|onclick|onmouseover|onfocus) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C).*(>|%3E) [NC]
    RewriteRule .* - [F,L]
</IfModule>


<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (alert|prompt|confirm|eval|setInterval|setTimeout|document\.cookie) [NC,OR]
    RewriteCond %{QUERY_STRING} (onerror|onload|onclick|onmouseover|onfocus) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C).*(>|%3E) [NC]
    RewriteRule .* - [F,L]
</IfModule>